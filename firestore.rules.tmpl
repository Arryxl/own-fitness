rules_version = '2';

// Template. `npm run rules:build` writes firestore.rules, replacing
// __ALLOWED_EMAILS__ with ALLOWED_EMAIL from the environment, so the
// allowlisted address never lives in the public repo.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [__ALLOWED_EMAILS__];
    }

    function isOwner(uid) {
      return signedInAllowed() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read: if isOwner(uid);
        // AI usage counters are written only by the server (Admin SDK bypasses rules).
        allow write: if isOwner(uid) && collection != 'aiUsage';
      }

      match /aiChats/{chatId}/messages/{messageId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
