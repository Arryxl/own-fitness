# Copy to .env.local (never commit it). In Vercel, set these in Project → Settings → Environment Variables.

# --- Gemini (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Max AI requests per day for the account (local guard; Google's own limits still apply)
AI_DAILY_LIMIT=150

# --- Access control (server only). Comma-separated list of Google emails allowed in. ---
ALLOWED_EMAIL=

# --- Firebase Admin (server only): service-account JSON encoded in base64 ---
FIREBASE_SERVICE_ACCOUNT=

# --- Firebase web app config (public by design; protected by Firestore rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
# In production use your own domain (e.g. ironlog.vercel.app): next.config rewrites /__/auth to Firebase.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local preview with sample data and no Firebase (ignored in production builds)
NEXT_PUBLIC_DEMO_MODE=0
