# Copy to .env.local (never commit it). In Vercel, set these in Project → Settings → Environment Variables.

# --- Gemini (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# free | paid. With "free", the AI only runs for users who accepted the AI consent
# (free-tier content may be used by Google to improve its products).
GEMINI_TIER=free

# --- AI quotas ---
# Per user per day (resets at midnight Pacific)
AI_DAILY_MESSAGES=60
AI_DAILY_TOKENS=400000
# All users together per day
AI_GLOBAL_DAILY_LIMIT=1000

# --- Admin (server only). Comma-separated emails that get the admin role.
# Run `npm run seed` after they sign up to set the admin custom claim.
ADMIN_EMAILS=

# --- Firebase Admin (server only): service-account JSON encoded in base64 ---
FIREBASE_SERVICE_ACCOUNT=

# --- Firebase web app config (public by design; protected by Firestore rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
# In production use your own domain (e.g. ironlog.vercel.app): next.config rewrites /__/auth to Firebase.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local development / tests only ---
# NEXT_PUBLIC_USE_EMULATORS=1   # point the app at the Firebase emulators
# AI_FAKE=1                     # deterministic fake AI (ignored in production)
