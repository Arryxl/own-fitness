{
  "name": "ironlog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "node scripts/with-java.mjs npx firebase-tools emulators:exec --only firestore,auth --project demo-ironlog \"vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "icons": "node scripts/gen-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "seed": "node --env-file-if-exists=.env.local scripts/seed-catalog.mjs",
    "prebuild": "vitest run lib/seed",
    "emulators": "node scripts/with-java.mjs npx firebase-tools emulators:start --only firestore,auth --project demo-ironlog"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
